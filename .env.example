# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public URL of the deployment. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Working title. The wordmark reads this at build time. Safe to change.
NEXT_PUBLIC_BRAND_NAME=VenueOne
# Optional. Shown on Contact and policy pages only when set.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# Local development database (optional)
# ---------------------------------------------------------------------------
# When DATABASE_URL is empty and NODE_ENV is not production, the app runs a
# real PostgreSQL engine locally through PGlite, persisted in .data/pglite.
# This is a development convenience, not a production database.
#
# For production, set the Supabase Postgres connection string (session pooler
# or direct connection, including sslmode=require).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (production authentication, storage, database)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket used for venue photographs. Create it as a public bucket.
SUPABASE_STORAGE_BUCKET=venue-photos

# ---------------------------------------------------------------------------
# Local development sign-in (never available in production)
# ---------------------------------------------------------------------------
# Set to true only on a trusted local machine. The server ignores this in
# production builds. Requires DEV_AUTH_PASSWORD to be at least 10 characters.
DEV_AUTH_ENABLED=false
DEV_AUTH_PASSWORD=
# Signing secret for local session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEV_SESSION_SECRET=
# Accounts provisioned only when local sign-in is enabled.
DEV_ADMIN_EMAIL=admin@local.test
DEV_OWNER_EMAIL=owner@local.test
DEV_PENDING_OWNER_EMAIL=pending-owner@local.test
DEV_CUSTOMER_EMAIL=customer@local.test

# ---------------------------------------------------------------------------
# Administrator bootstrap (production)
# ---------------------------------------------------------------------------
# Comma-separated, verified Google account emails that are promoted to Super
# Admin the first time they sign in. This is the controlled bootstrap path.
# Remove an address after at least one admin exists if you do not want it to
# retain standing access. Never put passwords here.
ADMIN_BOOTSTRAP_EMAILS=

# ---------------------------------------------------------------------------
# Razorpay (test mode in Phase 1)
# ---------------------------------------------------------------------------
# Leave empty to run the explicitly labelled demo payment flow. When the key
# starts with rzp_test_ the UI identifies every transaction as test mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local only. When no Razorpay keys are configured, the server can run an
# explicitly labelled demo payment flow so booking states remain testable.
# It is forcibly disabled when NODE_ENV=production or on Vercel, and whenever
# Razorpay keys exist. Set to false to turn it off locally as well.
DEMO_PAYMENTS_ENABLED=true

# ---------------------------------------------------------------------------
# Gmail Notification & Customer Support System
# ---------------------------------------------------------------------------
# Configure a standard Gmail address and a 16-character Google App Password.
# All notification emails (welcome greeting, booking confirmation, payment invoice,
# cancellation, and upcoming reminder) are dispatched through this Gmail account.
# If NEXT_PUBLIC_SUPPORT_EMAIL is empty, customer support defaults to this Gmail ID.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=VenueOne <notifications@venueone.in>

# Resend API (optional secondary fallback)
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Protects /api/cron/expire. Vercel Cron sends this automatically when the
# environment variable is set.
CRON_SECRET=
